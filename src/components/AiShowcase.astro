---
/**
 * A band under the hero that points to the on-device AI tools. It is plain links, so it works in every browser and
 * costs nothing on load; each target is a panel that says what to do if the browser cannot run it.
 */
import Icon from './Icon.astro';

const tools = [
  {
    icon: 'fa6-solid:comments',
    title: 'Ask about Shakoor',
    text: "A chat that answers from this site's own pages: the websites and apps built, the projects, the skills and the experience.",
    href: '/#ask',
    action: 'Start a chat',
  },
  {
    icon: 'fa6-solid:list-check',
    title: 'Check the fit for a role',
    text: 'Paste a job description and see which of its requirements this site gives evidence for, and which it does not.',
    href: '/services/#ai-fit',
    action: 'Check a job description',
  },
  {
    icon: 'fa6-solid:pen-to-square',
    title: 'Brief a project',
    text: 'Describe the website or app you need and get suggestions for the quote form, plus details worth adding.',
    href: '/quote/#ai-quote',
    action: 'Open the quote form',
  },
];
---

<section id="ai" class="ai-showcase" aria-labelledby="ai-showcase-title">
  <div class="container">
    <div class="ai-showcase-box">
      <p class="ai-kicker">
        <Icon name="fa6-solid:wand-magic-sparkles" /> New: on-device AI
      </p>
      <h2 id="ai-showcase-title">Try the AI on this site</h2>
      <p class="ai-lead">
        Three tools built on Chrome's on-device AI. They read only this site and run on your own computer, so nothing
        you type is sent to me or to anyone else.
      </p>
      <ul class="ai-tools">
        {tools.map((tool) => (
          <li>
            <a class="ai-tool" href={tool.href}>
              <Icon name={tool.icon} />
              <h3>{tool.title}</h3>
              <p>{tool.text}</p>
              <span class="more">
                {tool.action} <Icon name="fa6-solid:arrow-right" />
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="ai-note">They need Chrome on a desktop or laptop. In another browser, each tool explains what to do.</p>
    </div>
  </div>
</section>

<style lang="scss">
  /* A band, not a full section: the global `section` padding is for the big home sections. */
  .ai-showcase {
    padding: 8px 0 72px;
  }
  .ai-showcase-box {
    padding: 32px;
    background: var(--gh-canvas-subtle);
    border: 1px solid var(--gh-purple-muted);
    border-radius: 16px;
    background-image: linear-gradient(135deg, var(--gh-purple-subtle), var(--gh-accent-subtle));
  }
  .ai-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
    padding: 3px 12px;
    font-size: 12px;
    font-weight: 700;
    color: var(--gh-purple-fg);
    background: var(--gh-canvas);
    border: 1px solid var(--gh-purple-muted);
    border-radius: 999px;
  }
  h2 {
    margin-bottom: 8px;
    font-size: clamp(24px, 3.4vw, 32px);
    letter-spacing: -0.02em;
  }
  .ai-lead {
    max-width: 68ch;
    margin-bottom: 22px;
    font-size: 15.5px;
    line-height: 1.7;
  }
  .ai-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    list-style: none;
  }
  .ai-tool {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 20px;
    color: inherit;
    background: var(--gh-canvas);
    border: 1px solid var(--gh-border-default);
    border-radius: 12px;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .ai-tool:hover {
    color: inherit;
    border-color: var(--gh-purple-muted);
    transform: translateY(-2px);
  }
  .ai-tool :global(.icon) {
    margin-bottom: 12px;
    font-size: 22px;
    color: var(--gh-purple-fg);
  }
  .ai-tool h3 {
    margin-bottom: 6px;
    font-size: 17px;
  }
  .ai-tool p {
    flex: 1;
    margin-bottom: 14px;
    font-size: 14px;
    line-height: 1.65;
  }
  .ai-tool .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--gh-accent-text);
  }
  .ai-note {
    margin-top: 16px;
    font-size: 13px;
  }
  @media (max-width: 576px) {
    .ai-showcase-box {
      padding: 22px 18px;
    }
  }
</style>
