---
import RecommendationCard from './RecommendationCard.astro';
import { recommendations, recommendationsUrl } from '../data/recommendations';
---

<section id="recommendations" class="social-proof" aria-labelledby="social-proof-title">
  <div class="container">
    <div class="section-title social-proof-title">
      <h2 id="social-proof-title">Recommendations from Colleagues &amp; Managers</h2>
      <p>What people I have worked with wrote about me on LinkedIn, shown exactly as written.</p>
    </div>

    <div class="social-proof-grid">
      {recommendations.map((recommendation) => (
        <RecommendationCard recommendation={recommendation} />
      ))}
    </div>

    <!-- The period must directly follow the link: no whitespace between </a> and "." -->
    <!-- prettier-ignore -->
    <p class="social-proof-link">
      Read them in full on my
      <a href={recommendationsUrl} target="_blank" rel="noopener noreferrer">LinkedIn profile</a>.
    </p>
  </div>
</section>

<style lang="scss">
  .social-proof {
    background: var(--gh-canvas-subtle);
    border-top: 1px solid var(--gh-border-default);
    border-bottom: 1px solid var(--gh-border-default);
    padding: 72px 0;
  }

  .social-proof-title {
    margin-bottom: 36px;
  }

  .social-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .social-proof-link {
    margin-top: 18px;
    font-size: 14px;
    color: var(--gh-fg-subtle);
  }

  .social-proof-link a {
    color: var(--gh-accent-fg);
    font-weight: 600;
  }

  @media (max-width: 992px) {
    .social-proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
