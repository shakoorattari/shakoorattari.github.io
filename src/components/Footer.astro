---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getPublishedPosts } from '../lib/blog';
import { getBuildInfo } from '../lib/version';
import { getAnalyticsConfig } from '../lib/analytics';

const hasPosts = (await getPublishedPosts()).length > 0;

const build = getBuildInfo();
const analytics = getAnalyticsConfig();
const builtOn = build.commitDate.slice(0, 10);
const versionTitle = `Version ${build.version} · build ${build.commitShort}${build.dirty ? ' (modified)' : ''} · ${builtOn}`;

const social = [
  { icon: 'fa6-brands:linkedin', url: site.social.linkedin, label: 'LinkedIn' },
  { icon: 'fa6-brands:github', url: site.social.github, label: 'GitHub' },
  { icon: 'fa6-brands:x-twitter', url: site.social.x, label: 'X (Twitter)' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-content">
      <nav class="footer-nav" aria-label="Footer">
        <a href="/services/">Services</a>
        <a href="/work/">Work</a>
        <a href="/projects/">Case studies</a>
        <a href="/ielts/">IELTS app</a>
        <a href="/quote/">Request a quote</a>
        {hasPosts && <a href="/blog/">Articles</a>}
        <a href="/#contact">Contact</a>
        <a href="/privacy/">Privacy</a>
        {analytics.ga.enabled && (
          <button type="button" class="link-button" data-consent-settings>
            Privacy choices
          </button>
        )}
      </nav>
      <div class="copyright">
        <p>
          &copy; <span id="year">{new Date().getFullYear()}</span> {site.name}. All Rights Reserved.
          <!-- The dot must have no whitespace inside it; ignore applies per-node, so the link needs its own too. -->
          <!-- prettier-ignore -->
          <span class="dot" aria-hidden="true">·</span>
          <!-- prettier-ignore -->
          <a class="version" href={build.releaseUrl} target="_blank" rel="noopener noreferrer" title={versionTitle}>v{build.version}</a>
        </p>
      </div>
      <div class="social-links">
        {social.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Follow me on ${item.label}`}
            title={`Follow me on ${item.label}`}
          >
            <Icon name={item.icon} />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    display: block;
    background-color: var(--gh-canvas-inset);
    color: var(--gh-fg-muted);
    padding: 32px 0;
    border-top: 1px solid var(--gh-border-default);
    position: relative;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .copyright p {
    font-size: 13px;
    color: var(--gh-fg-subtle);
    margin: 0;
  }

  .social-links {
    display: flex;
    gap: 8px;
  }

  .social-links a {
    width: 36px;
    height: 36px;
    background-color: var(--gh-canvas-overlay);
    border: 1px solid var(--gh-border-default);
    color: var(--gh-fg-default);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.2s ease;
    font-size: 14px;
  }

  .social-links a:hover {
    background-color: var(--gh-canvas-elevated);
    border-color: var(--gh-accent-muted);
    color: var(--gh-accent-fg);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }

  .dot {
    color: var(--gh-border-default);
    margin: 0 2px;
  }

  .version {
    color: var(--gh-fg-subtle);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
  }

  .version:hover {
    color: var(--gh-accent-fg);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 13px;
  }
  .footer-nav a,
  .link-button {
    color: var(--gh-fg-muted);
  }
  .footer-nav a:hover,
  .link-button:hover {
    color: var(--gh-accent-fg);
  }

  .link-button {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
  }
</style>
