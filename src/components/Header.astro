---
import { getPublishedPosts } from '../lib/blog';

interface Props {
  /** True on the home page, where nav items are in-page anchors. Elsewhere they point back to "/#id". */
  home?: boolean;
  /** Which section page is open, to mark its link as current. */
  current?: 'services' | 'projects' | 'work' | 'quote' | 'blog';
}

const { home = false, current } = Astro.props;
const anchor = (id: string) => (home ? `#${id}` : id === 'home' ? '/' : `/#${id}`);
const hasPosts = (await getPublishedPosts()).length > 0;

const items: { label: string; href: string; page?: string; cta?: boolean }[] = [
  { label: 'Home', href: anchor('home') },
  { label: 'About', href: anchor('about') },
  { label: 'Skills', href: anchor('skills') },
  { label: 'Experience', href: anchor('experience') },
  { label: 'Work', href: '/work/', page: 'work' },
  { label: 'Case Studies', href: anchor('projects') },
  { label: 'Services', href: '/services/', page: 'services' },
  ...(hasPosts ? [{ label: 'Blog', href: '/blog/', page: 'blog' }] : []),
  { label: 'Contact', href: anchor('contact') },
  { label: 'Get a quote', href: '/quote/', page: 'quote', cta: true },
];
---

<header class="site-header">
  <div class="container">
    <nav aria-label="Primary">
      <a class="logo" href={home ? '#home' : '/'} aria-label="Shakoor Hussain Attari — home">
        <svg class="logo-icon" viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="sha-grad" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#2f81f7" />
              <stop offset="100%" stop-color="#a371f7" />
            </linearGradient>
          </defs>
          <polygon points="18,2 32,10 32,26 18,34 4,26 4,10" stroke="url(#sha-grad)" stroke-width="1.5" fill="none" />
          <text
            x="18"
            y="24.5"
            text-anchor="middle"
            fill="url(#sha-grad)"
            font-size="18"
            font-weight="700"
            font-family="-apple-system,system-ui,sans-serif"
          >
            S
          </text>
        </svg>
        <!-- Inline spans must stay adjacent: whitespace between them would widen the logo. -->
        <!-- prettier-ignore -->
        <span class="logo-text"><span class="logo-bracket">&lt;</span><span class="logo-name">SHA</span><span class="logo-bracket">&nbsp;/&gt;</span></span>
      </a>
      <ul class="nav-links" id="primary-navigation">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={{ active: !!item.page && item.page === current, 'nav-cta': item.cta }}
              aria-current={item.page && item.page === current ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>

<style lang="scss">
  .site-header {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 12px 0;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      backdrop-filter 0.25s ease;
    background-color: rgba(13, 17, 23, 0.7);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
  }

  .site-header.scrolled {
    background-color: rgba(13, 17, 23, 0.85);
    border-bottom-color: var(--gh-border-default);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 40px;
  }

  .logo {
    cursor: pointer;
    color: inherit;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    user-select: none;
  }

  .logo-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    filter: drop-shadow(0 0 5px rgba(163, 113, 247, 0.35));
    transition:
      filter 0.3s ease,
      transform 0.35s ease;
  }

  .logo:hover .logo-icon {
    filter: drop-shadow(0 0 10px rgba(163, 113, 247, 0.65));
    transform: rotate(15deg);
  }

  .logo-text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .logo-bracket {
    color: var(--gh-accent-fg);
    font-weight: 400;
    opacity: 0.85;
  }

  .logo-name {
    background: var(--gh-gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 4px;
    align-items: center;
  }

  .nav-links li a {
    color: var(--gh-fg-default);
    font-weight: 500;
    font-size: 14px;
    padding: 6px 12px;
    border-radius: 6px;
    position: relative;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-links li a:hover {
    color: var(--gh-fg-default);
    background-color: rgba(177, 186, 196, 0.12);
  }

  .nav-links li a.active {
    color: var(--gh-fg-default);
    background-color: rgba(177, 186, 196, 0.08);
  }

  /* The quote button: a filled link at the end of the menu. White on #1f6feb is 5:1. */
  .nav-links li a.nav-cta {
    margin-left: 6px;
    color: #fff;
    font-weight: 600;
    background-color: var(--gh-accent-emphasis);
  }

  .nav-links li a.nav-cta:hover,
  .nav-links li a.nav-cta.active {
    color: #fff;
    background-color: #388bfd;
  }

  .nav-links li a.nav-cta::after {
    display: none;
  }

  .nav-links li a.active::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--gh-purple), var(--gh-accent-fg));
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    appearance: none;
    padding: 8px;
    border-radius: 6px;
    border: 1px solid var(--gh-border-default);
    background: var(--gh-canvas-overlay);
  }

  .menu-toggle span {
    width: 18px;
    height: 2px;
    background-color: var(--gh-fg-default);
    transition: all 0.3s ease;
  }

  .menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  /* Ten links need more room than the original seven, so the menu collapses earlier. */
  @media (max-width: 920px) {
    .nav-links {
      position: fixed;
      top: 64px;
      left: -100%;
      width: 100%;
      height: calc(100vh - 64px);
      background-color: var(--gh-canvas);
      border-top: 1px solid var(--gh-border-default);
      flex-direction: column;
      align-items: center;
      justify-content: safe center;
      overflow-y: auto;
      gap: 6px;
      transition: left 0.25s ease;
    }

    .nav-links.active {
      left: 0;
    }

    .nav-links li a {
      font-size: 18px;
      padding: 10px 24px;
    }

    .nav-links li a.nav-cta {
      margin: 6px 0 0;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>
