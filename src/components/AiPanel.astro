---
/**
 * Shell for every on-device AI feature. It renders the heading, the "use Chrome" notice, the shared status line,
 * download progress, the "download the model?" question and the fine print, and puts the feature's own controls in
 * the slot. src/scripts/ai/panels.ts decides at load whether this browser can run it (notice or controls) and loads
 * the feature's code only when a button is pressed. Without JavaScript the whole panel is hidden.
 */
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  intro: string;
  /** Which Chrome API the feature needs: decides the support check and the minimum Chrome version in the notice. */
  api: 'prompt' | 'summarizer';
  /** Which module in src/scripts/ai/features/ runs the controls. */
  feature: 'summary' | 'quote' | 'fit' | 'chat';
  /** Heading level, so the panel sits correctly in the page's outline. */
  level?: 2 | 3;
  /** A smaller panel for places where it sits beside the main content (a form, the top of an article). */
  compact?: boolean;
  /** CSS selector of the text a summary reads. */
  source?: string;
  /** Replaces the default privacy line. */
  fine?: string;
  class?: string;
}

const {
  id,
  title,
  intro,
  api,
  feature,
  level = 2,
  compact = false,
  source,
  fine = 'Runs on your computer in Chrome: what you type here is not sent to this site. On-device AI can be wrong, so check the sources it links to.',
  class: className,
} = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
---

<section
  id={id}
  class:list={['ai-panel', { compact }, className]}
  aria-labelledby={`${id}-title`}
  data-ai-panel
  data-ai-api={api}
  data-ai-feature={feature}
  data-ai-source={source}
>
  <p class="ai-badge">
    <Icon name="fa6-solid:wand-magic-sparkles" /> On-device AI, in Chrome
  </p>
  <Heading id={`${id}-title`}>{title}</Heading>
  <p class="ai-intro">{intro}</p>

  <div class="ai-notice" data-ai-notice hidden>
    <p>
      <strong data-ai-notice-title></strong>
      <span data-ai-notice-body></span>
    </p>
    <button type="button" class="btn secondary-btn" data-ai-copy>
      <Icon name="fa6-solid:copy" /> Copy page link
    </button>
  </div>

  <div class="ai-body" data-ai-body hidden>
    <slot />

    <div class="ai-confirm" data-ai-confirm hidden>
      <p data-ai-confirm-text></p>
      <div class="ai-actions">
        <button type="button" class="btn primary-btn" data-ai-confirm-yes>
          Download and continue
        </button>
        <button type="button" class="btn secondary-btn" data-ai-confirm-no>
          Not now
        </button>
      </div>
    </div>
    <progress
      class="ai-progress"
      data-ai-progress
      max="1"
      value="0"
      hidden
      aria-label="Model download progress"
    ></progress>
    <p class="ai-status" role="status" data-ai-status></p>
    <button type="button" class="btn secondary-btn" data-ai-stop hidden>
      <Icon name="fa6-solid:stop" /> Stop
    </button>
    <p class="ai-fine">
      <Icon name="fa6-solid:shield-halved" /> {fine}
    </p>
  </div>
</section>

<style lang="scss">
  /* Hidden until the page is scripted (the inline script in Base.astro adds .js): nothing here works without JavaScript. */
  .ai-panel {
    display: none;
    padding: 22px 24px;
    background: var(--gh-canvas-subtle);
    border: 1px solid var(--gh-border-default);
    border-left: 3px solid var(--gh-purple);
    border-radius: 12px;
  }
  :global(.js) .ai-panel {
    display: block;
  }
  .ai-panel.compact {
    padding: 14px 18px;
  }

  .ai-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    padding: 2px 10px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--gh-purple-fg);
    background: var(--gh-purple-subtle);
    border: 1px solid var(--gh-purple-muted);
    border-radius: 999px;
  }
  .ai-panel :is(h2, h3) {
    font-size: 20px;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .ai-panel.compact :is(h2, h3) {
    font-size: 16px;
    margin-bottom: 4px;
  }
  .ai-intro {
    font-size: 14px;
    line-height: 1.65;
    max-width: 70ch;
  }
  .ai-panel.compact .ai-intro {
    font-size: 13px;
  }

  .ai-notice {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  .ai-notice p {
    flex: 1 1 320px;
    font-size: 14px;
    line-height: 1.6;
  }
  .ai-notice strong {
    display: block;
    color: var(--gh-fg-default);
  }

  .ai-body {
    margin-top: 16px;
  }
  .ai-panel.compact .ai-body {
    margin-top: 12px;
  }
  .ai-status {
    min-height: 1.4em;
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.5;
  }
  .ai-status[data-tone='error'] {
    color: var(--gh-danger-fg);
  }
  .ai-progress {
    display: block;
    width: 100%;
    height: 8px;
    margin-top: 12px;
    accent-color: var(--gh-accent-fg);
  }
  .ai-confirm {
    margin-top: 14px;
    padding: 14px 16px;
    background: var(--gh-canvas-overlay);
    border: 1px solid var(--gh-border-default);
    border-radius: 10px;
  }
  .ai-confirm p {
    margin-bottom: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--gh-fg-default);
  }
  .ai-fine {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin-top: 14px;
    font-size: 12px;
    line-height: 1.55;
  }
  .ai-fine :global(.icon) {
    flex: none;
    margin-top: 2px;
  }

  /* Controls: the shared .btn from global.scss, allowed to wrap and kept finger-sized. */
  .ai-panel :global(.btn) {
    min-height: 44px;
    white-space: normal;
    text-align: center;
  }
  .ai-panel :global([aria-disabled='true']) {
    opacity: 0.6;
    cursor: progress;
  }
  .ai-panel :global(.ai-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ai-panel :global(.ai-label) {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--gh-fg-default);
  }
  .ai-panel :global(.ai-field) {
    width: 100%;
    padding: 11px 12px;
    background: var(--gh-canvas-inset);
    border: 1px solid var(--gh-border-default);
    border-radius: 8px;
    color: var(--gh-fg-default);
    font-family: inherit;
    font-size: 14px;
    line-height: 1.55;
    transition: border 0.2s;
  }
  .ai-panel :global(textarea.ai-field) {
    min-height: 150px;
    margin-bottom: 12px;
    resize: vertical;
  }
  .ai-panel :global(.ai-field::placeholder) {
    color: var(--gh-fg-subtle);
    opacity: 1;
  }
  .ai-panel :global(.ai-field:focus) {
    outline: 0;
    border-color: var(--gh-accent-fg);
    box-shadow: 0 0 0 3px var(--gh-accent-subtle);
  }
  .ai-panel :global(.ai-inline) {
    display: flex;
    gap: 10px;
  }
  .ai-panel :global(.ai-inline .ai-field) {
    flex: 1;
    min-width: 0;
  }

  /* Example questions */
  .ai-panel :global(.ai-examples) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .ai-panel :global(.ai-example) {
    padding: 7px 12px;
    background: var(--gh-canvas-overlay);
    border: 1px solid var(--gh-border-default);
    border-radius: 999px;
    color: var(--gh-fg-default);
    font-family: inherit;
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
    transition: var(--transition);
  }
  .ai-panel :global(.ai-example:hover) {
    border-color: var(--gh-accent-muted);
    background: var(--gh-canvas-elevated);
  }

  /* Results */
  .ai-panel :global(.ai-output) {
    margin-top: 16px;
    padding: 16px 18px;
    background: var(--gh-canvas-inset);
    border: 1px solid var(--gh-border-default);
    border-radius: 10px;
  }
  .ai-panel :global(.ai-output) {
    /* Focus moves here after a result: keep it clear of the fixed header. */
    scroll-margin-top: 88px;
  }
  .ai-panel :global(.ai-block) {
    margin-top: 16px;
  }
  .ai-panel :global(.ai-output:focus-visible) {
    outline: 2px solid var(--gh-accent-fg);
    outline-offset: 2px;
  }
  .ai-panel :global(.ai-output-title) {
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gh-fg-muted);
  }
  .ai-panel :global(.ai-output-title:not(:first-child)) {
    margin-top: 16px;
  }
  .ai-panel :global(.ai-summary) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--gh-fg-default);
  }
  .ai-panel :global(.ai-after) {
    margin-top: 14px;
    font-size: 12.5px;
    line-height: 1.6;
  }
  .ai-panel :global(.ai-list),
  .ai-panel :global(.ai-results),
  .ai-panel :global(.ai-suggestions),
  .ai-panel :global(.ai-evidence) {
    list-style: none;
  }
  .ai-panel :global(.ai-list) {
    display: grid;
    gap: 8px;
  }
  .ai-panel :global(.ai-list li) {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--gh-fg-default);
  }
  .ai-panel :global(.ai-list li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gh-purple);
  }
  /* A link inside a sentence must not rely on colour alone (WCAG 1.4.1). */
  .ai-panel :global(.ai-output a),
  .ai-panel :global(.ai-after a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Chat */
  .ai-panel :global(.ai-transcript) {
    list-style: none;
    display: grid;
    gap: 12px;
    max-height: min(52vh, 480px);
    margin-bottom: 14px;
    padding-right: 4px;
    overflow-y: auto;
  }
  .ai-panel :global(.ai-transcript:empty) {
    display: none;
  }
  .ai-panel :global(.ai-turn-q) {
    justify-self: end;
    max-width: 88%;
    padding: 10px 14px;
    background: var(--gh-accent-subtle);
    border: 1px solid var(--gh-accent-muted);
    border-radius: 12px 12px 4px 12px;
    font-size: 14.5px;
    line-height: 1.6;
  }
  .ai-panel :global(.ai-turn-q p) {
    color: var(--gh-fg-default);
  }
  .ai-panel :global(.ai-turn-a) {
    justify-self: start;
    width: 100%;
    padding: 12px 16px;
    background: var(--gh-canvas-inset);
    border: 1px solid var(--gh-border-default);
    border-radius: 12px 12px 12px 4px;
  }
  .ai-panel :global(.ai-turn-a.ai-fallback) {
    border-style: dashed;
  }
  .ai-panel :global(.ai-a-label) {
    margin-bottom: 4px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gh-purple-fg);
  }
  .ai-panel :global(.ai-a-text) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--gh-fg-default);
  }
  .ai-panel :global(.ai-sources-line) {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.6;
  }
  .ai-panel :global(.ai-sources-line a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ai-panel :global(.ai-clear) {
    margin-top: 10px;
    padding: 6px 0;
    background: none;
    border: 0;
    color: var(--gh-accent-text);
    font: inherit;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* Quote suggestions: label, value, button */
  .ai-panel :global(.ai-suggestions) {
    display: grid;
    gap: 10px;
  }
  .ai-panel :global(.ai-suggestions li) {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    align-items: center;
    gap: 6px 12px;
    font-size: 14px;
  }
  .ai-panel :global(.ai-field-name) {
    color: var(--gh-fg-muted);
  }
  .ai-panel :global(.ai-value) {
    color: var(--gh-fg-default);
    font-weight: 600;
  }
  .ai-panel :global(.ai-apply) {
    min-height: 36px;
    padding: 6px 14px;
  }

  /* Job fit rows */
  .ai-panel :global(.ai-results) {
    display: grid;
    gap: 14px;
    margin-top: 12px;
  }
  .ai-panel :global(.ai-row) {
    padding-top: 14px;
    border-top: 1px solid var(--gh-border-muted);
  }
  .ai-panel :global(.ai-row:first-child) {
    padding-top: 0;
    border-top: 0;
  }
  .ai-panel :global(.ai-requirement) {
    margin-bottom: 6px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--gh-fg-default);
  }
  .ai-panel :global(.ai-chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid var(--gh-border-default);
    border-radius: 999px;
    color: var(--gh-fg-muted);
  }
  /* A mark as well as a colour: status never relies on colour alone. */
  .ai-panel :global(.ai-chip::before) {
    content: '–' / '';
  }
  .ai-panel :global(.ai-strong) {
    color: var(--gh-success-fg);
    background: var(--gh-success-subtle);
    border-color: var(--gh-success-muted);
  }
  .ai-panel :global(.ai-strong::before) {
    content: '✓' / '';
  }
  .ai-panel :global(.ai-partial) {
    color: var(--gh-chip-fg);
    background: var(--gh-chip-bg);
    border-color: var(--gh-chip-border);
  }
  .ai-panel :global(.ai-partial::before) {
    content: '◐' / '';
  }
  .ai-panel :global(.ai-evidence) {
    display: grid;
    gap: 6px;
    margin-top: 8px;
  }
  .ai-panel :global(.ai-evidence li) {
    font-size: 13px;
    line-height: 1.6;
    color: var(--gh-fg-muted);
  }

  @media (max-width: 640px) {
    .ai-panel {
      padding: 18px;
    }
    .ai-panel.compact {
      padding: 14px;
    }
    .ai-panel :global(.ai-inline) {
      flex-direction: column;
    }
    .ai-panel :global(.btn) {
      width: 100%;
    }
    .ai-panel :global(.ai-suggestions li) {
      grid-template-columns: 1fr;
    }
    .ai-panel :global(.ai-apply) {
      justify-self: start;
      width: auto;
    }
  }
</style>
