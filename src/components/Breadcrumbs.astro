---
interface Props {
  crumbs: { name: string; href: string }[];
}
const { crumbs } = Astro.props;
const all = [{ name: 'Home', href: '/' }, ...crumbs];
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      all.map((crumb, i) => (
        <li>
          {i < all.length - 1 ? <a href={crumb.href}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>
