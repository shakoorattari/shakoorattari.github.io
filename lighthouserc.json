{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "/index.html",
        "/services/index.html",
        "/services/identity-sso-oauth/index.html",
        "/services/web-application-development/index.html",
        "/projects/index.html",
        "/projects/oneportal-iam/index.html",
        "/work/index.html",
        "/work/earth-cone/index.html",
        "/work/uae-information-chatbot/index.html",
        "/quote/index.html"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --blink-settings=preferredColorScheme=1"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 150
          }
        ],
        "errors-in-console": [
          "error",
          {
            "maxLength": 0
          }
        ],
        "is-crawlable": "error",
        "canonical": "error",
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 20000
          }
        ],
        "resource-summary:third-party:count": [
          "error",
          {
            "maxNumericValue": 2
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 200000
          }
        ],
        "dom-size": [
          "warn",
          {
            "maxNumericValue": 1500
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
