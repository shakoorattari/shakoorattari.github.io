# All optional. These are PUBLIC values (they end up in the page), so it is fine to set them
# as plain GitHub repository *variables* (Settings → Secrets and variables → Actions → Variables);
# the workflows pass them to the build. Nothing is emitted while a value is empty.

# Google Analytics 4 Measurement ID ("G-XXXXXXXXXX"). OPT-IN: a consent notice appears and Google's script loads
# only after a visitor accepts. Only active in production builds, and only on the production hostname.
# A malformed value fails the build. Use a FAKE id for local experiments (never the real one).
# See docs/analytics.md.
PUBLIC_GA_MEASUREMENT_ID=

# Hostnames allowed to send Google Analytics, comma-separated. Default: the production domain and www.
# Only set this for local testing (e.g. localhost) together with a fake id.
PUBLIC_GA_HOSTS=

# Cloudflare Web Analytics beacon token (cookieless analytics).
PUBLIC_CF_ANALYTICS_TOKEN=

# Search Console "URL prefix" verification meta tag content.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification meta tag content.
PUBLIC_BING_SITE_VERIFICATION=
